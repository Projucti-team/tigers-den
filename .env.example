# Payload CMS
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Local dev + production: SQLite (persisted volume on Coolify/VPS).
DATABASE_URI=file:./tigersden.db

# Public site URL (must match where you open /admin — use http://localhost:3000 locally)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Member sign-in (Google + Facebook) — https://authjs.dev
AUTH_SECRET=generate-with-openssl-rand-base64-32
# Google Cloud → OAuth client (Web) → Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://tigersden.bd/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Meta app → Facebook Login → Settings → Valid OAuth Redirect URIs:
#   http://localhost:3000/api/auth/callback/facebook
#   https://YOUR_DOMAIN/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Cricket data (see docs/cricket-api.md) — CricAPI key for /tours index only; tour detail pages use ESPN snapshots from nightly sync
CRICKET_DATA_API_KEY=
# Optional second cricketdata.org account key — used automatically when the primary hits its daily quota
CRICKET_DATA_API_KEY_FALLBACK=
# Optional third account key — rotated after the first fallback is exhausted
CRICKET_DATA_API_KEY_FALLBACK_2=

# Secures GET /api/cron/cricket (Coolify schedule sends Authorization: Bearer …)
CRON_SECRET=generate-with-openssl-rand-base64-32

# The Roar live chat (Firebase Firestore — real-time, not Postgres)
# Firebase console → Project settings → Your apps → Web app (public keys)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Firebase console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste private key with literal \n line breaks (or wrap in quotes in Coolify)
FIREBASE_PRIVATE_KEY=

# Google Analytics 4 — GA4 console → Admin → Data streams → your web stream → Measurement ID
# (leave blank to disable; no GA script loads without it)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# GA4 reporting API — pulls stats (users/pageviews last 24h) into the Payload admin dashboard.
# Separate from the public Measurement ID above; needs a Google Cloud service account with the
# "Google Analytics Data API" enabled and Viewer access on the GA4 property (GA4 → Admin →
# Property Access Management → add the service account's email as a Viewer).
#
# GA_CLIENT_EMAIL / GA_PRIVATE_KEY(_B64) below are OPTIONAL — if left blank, this automatically
# reuses FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY(_B64) above. GA4 Viewer is read-only, so
# the same service account already used for The Roar's Firestore access can safely double up
# here too — just grant it Viewer on the GA4 property and skip GA_CLIENT_EMAIL/GA_PRIVATE_KEY
# entirely. Only set them if you'd rather use a separate dedicated service account.
# GA4 → Admin → Property details → Property ID (numeric, NOT the G-XXXX Measurement ID) — always required.
GA_PROPERTY_ID=
# Optional — defaults to FIREBASE_CLIENT_EMAIL.
GA_CLIENT_EMAIL=
# Optional — defaults to FIREBASE_PRIVATE_KEY_B64. Base64-encoded PEM in one line
# (e.g. `node -e "console.log(Buffer.from(require('./key.json').private_key).toString('base64'))"`)
# — survives Coolify/shell mangling much better than pasting the raw multi-line PEM.
GA_PRIVATE_KEY_B64=
# Optional — defaults to FIREBASE_PRIVATE_KEY. Legacy fallback: raw PEM (with literal \n line breaks).
GA_PRIVATE_KEY=

# Deployment: docs/deploy-coolify.md | docs/deploy-production.md
